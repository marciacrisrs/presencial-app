<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="presencial.db"/>
        <include domain="sharedpref" path="presencial_settings.xml"/>
        <include domain="file" path="datastore/presencial_settings.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="presencial.db"/>
        <include domain="sharedpref" path="presencial_settings.xml"/>
        <include domain="file" path="datastore/presencial_settings.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
